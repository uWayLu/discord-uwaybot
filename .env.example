DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://gemini.uwaylu.net/v1
OPENAI_MODEL=gemini-3-flash

# Adaptive 模型路由：定時探測 smart 模型延遲，快就用它、慢自動切 fast
# MODEL_PROBE_MAX_MS: smart 短請求超過此毫秒數就切到 fast；MODEL_PROBE_INTERVAL_MIN: 探測間隔(分)
# 設 MODEL_PROBE_ENABLED=0 可停用 → 永遠使用 MODEL_SMART
MODEL_PROBE_ENABLED=0
MODEL_PROBE_INTERVAL_MIN=10
MODEL_PROBE_MAX_MS=25000
MODEL_SMART=big-pickle
MODEL_FAST=deepseek-v4-flash-free

SUMMARY_MAX_HOURS=24
SUMMARY_TOP_MINUTES=10

# 回覆冷卻（毫秒）
DIRECTED_COOLDOWN_CHANNEL_MS=5000
DIRECTED_COOLDOWN_USER_MS=5000

# GIF/梗圖 — 用 memes.tw 熱門 feed + LLM 選圖（免 key）
# MEMES_CONTEST 可選填限定分類 id（空 = 全站熱門）
GIF_ENABLED=1
GIF_PROB=20
MEMES_CONTEST=

# 聊天 session 記憶（per-channel，閒置自動重置）
CHAT_SESSION_IDLE_MIN=30
CHAT_SESSION_MAX_TURNS=20
CHAT_SESSION_MAX_CHARS=8000

# 搜尋計數模式（/search count:True）省略 duration 時的預設天數
SEARCH_COUNT_DEFAULT_DAYS=30

# bot 人設（愛接梗酸脆型）；0 = 關閉退回中立
PERSONA_ENABLED=1

# 本地全文 RAG：@聊天 / /deep / /search 先查全文庫補足歷史依據
# RAG_RANGE_DAYS=0 表示全部歷史；RAG_BM25_THRESHOLD=0 表示不額外過濾
RAG_ENABLED=1
RAG_TOP_K=6
RAG_RANGE_DAYS=0
RAG_MIN_QUERY_CHARS=2
RAG_BM25_THRESHOLD=0
